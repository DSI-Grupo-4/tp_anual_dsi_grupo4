# Copiar a servicio-donaciones/.env (no se versiona). run-servicios lo carga solo.
# true: la API exige el token de Keycloak y las tareas automáticas piden el suyo.
SEGURIDAD_HABILITADA=false
# Secret del cliente "servicio-donaciones": el mismo valor que
# KEYCLOAK_DONACIONES_CLIENT_SECRET de keycloak/.env, o el de la consola
# (realm donatrack → Clients → servicio-donaciones → Credentials).
KEYCLOAK_CLIENT_SECRET=pegar-el-secret-del-cliente
