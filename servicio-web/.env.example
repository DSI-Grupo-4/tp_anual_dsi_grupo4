# Copiar a servicio-web/.env (no se versiona).
# Es el client secret del cliente "servicio-web" de Keycloak:
# consola → realm donatrack → Clients → servicio-web → Credentials.
# No es una contraseña de usuario ni la del administrador de la consola.
KEYCLOAK_CLIENT_SECRET=pegar-el-secret-del-cliente

# Solo si Keycloak no está en el puerto local por defecto.
# KEYCLOAK_URL=http://localhost:8180
