# Copiar a servicio-web/.env (no se versiona). Opcional: con keycloak/.env
# configurado, run-servicios ya deriva KEYCLOAK_CLIENT_SECRET y
# SEGURIDAD_HABILITADA solo. Este archivo es para overrides puntuales de
# este módulo (por ejemplo, dejarlo sin seguridad mientras el resto sí la
# tiene) o para arrancarlo a mano con `mvn spring-boot:run` sin run-servicios.

# true: las llamadas a las APIs llevan token.
# Si no se define acá, run-servicios la pone en true cuando existe keycloak/.env.
SEGURIDAD_HABILITADA=false

# Client secret del cliente "servicio-web" de Keycloak (consola → realm
# donatrack → Clients → servicio-web → Credentials). Solo hace falta acá si
# se arranca el módulo a mano, sin run-servicios, o para pisar el valor de
# KEYCLOAK_WEB_CLIENT_SECRET de keycloak/.env.
KEYCLOAK_CLIENT_SECRET=pegar-el-secret-del-cliente

# Solo si Keycloak no está en el puerto local por defecto.
# KEYCLOAK_URL=http://localhost:8180
