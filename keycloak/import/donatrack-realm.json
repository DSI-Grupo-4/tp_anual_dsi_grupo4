{
  "id": "donatrack",
  "realm": "donatrack",
  "displayName": "DonaTrack",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "loginTheme": "donatrack",
  "internationalizationEnabled": true,
  "supportedLocales": ["es"],
  "defaultLocale": "es",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Persona administradora de DonaTrack",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "DONANTE",
        "description": "Persona donante",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "BENEFICIARIA",
        "description": "Entidad beneficiaria",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "servicio-web",
      "name": "Cliente web de DonaTrack",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:8085",
      "redirectUris": [
        "http://localhost:8085/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8085"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8085##http://localhost:8085/"
      }
    }
  ]
}
