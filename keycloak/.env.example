# Copiar este archivo a keycloak/.env y elegir contraseñas locales.
# keycloak/.env NO se versiona. No completar este ejemplo con claves reales.
#
# El usuario de acá es el administrador de la consola de Keycloak (realm master).
# No es un donante, una beneficiaria ni un administrador de DonaTrack.

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=definir-una-clave-local

# Contraseña del usuario MySQL "keycloak", que solo tiene permisos sobre la
# base "keycloak". Sin comillas simples ni barras invertidas.
# Si se cambia, el próximo "up" de Keycloak la actualiza en MySQL.
KEYCLOAK_DB_PASSWORD=definir-otra-clave-local

# Clave de root de MySQL, la misma que usa el servicio "mysql" del compose.
# La usa solo keycloak-db-init para crear la base y el usuario. Sin ella, el
# inicializador falla y Keycloak no arranca.
KEYCLOAK_DB_ROOT_PASSWORD=definir-clave-root-de-mysql

# Secrets de los clientes confidenciales. keycloak-config los aplica en
# Keycloak y cada servicio usa el mismo valor en su propio .env
# (KEYCLOAK_CLIENT_SECRET). Mínimo 16 caracteres: letras, números y . _ ~ -
# Si quedan vacíos, el cliente conserva el secret que ya tenía en Keycloak.
KEYCLOAK_WEB_CLIENT_SECRET=
KEYCLOAK_DONACIONES_CLIENT_SECRET=
KEYCLOAK_INCENTIVOS_CLIENT_SECRET=

# Cliente OAuth de Google Cloud (ver GUIA-LEVANTAR-SERVICIOS.md, "Ingreso con Google").
# Vacíos = no se ofrece el botón de Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
