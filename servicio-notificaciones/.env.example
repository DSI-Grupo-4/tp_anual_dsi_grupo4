# Copiar este archivo a servicio-notificaciones/.env y completar con credenciales reales.
# .env NO se versiona (ver .gitignore) -- nunca commitear credenciales reales.
#
# run-servicios.sh carga este archivo automaticamente antes de levantar
# servicio-notificaciones. Sin el, el servicio sigue enviando contra Mailpit
# (bandeja de prueba local, http://localhost:8025) como hasta ahora.

# SMTP de Gmail. Requiere verificacion en 2 pasos activada en la cuenta y
# una "contrasena de aplicacion" generada en myaccount.google.com/apppasswords
# (NO la contrasena normal de la cuenta).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-cuenta@gmail.com
MAIL_PASSWORD=contrasena-de-aplicacion-16-caracteres
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_REMITENTE=tu-cuenta@gmail.com
