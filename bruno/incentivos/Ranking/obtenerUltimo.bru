meta {
  name: obtenerUltimo
  type: http
  seq: 3
  tags: [
    Ranking
  ]
}

get {
  url: {{baseUrl}}/ranking/ultimo
  body: none
  auth: none
}

docs {
  Top de donantes del último ranking mensual generado. 404 si todavía no se generó ninguno -- validado en vivo.
}

example {
  name: 404 Response
  description: Not Found (sin ningún ranking generado todavía)

  request: {
    url: {{baseUrl}}/ranking/ultimo
    method: GET
    mode: none
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''
        {
          "error": "Todavía no se generó ningún ranking mensual"
        }
      '''
    }
  }
}
