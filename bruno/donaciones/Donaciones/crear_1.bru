meta {
  name: crear (carga multi-ítem - Arcos Plateados)
  type: http
  seq: 5
  tags: [
    Donaciones
  ]
}

post {
  url: {{baseUrl}}/api/donaciones
  body: json
  auth: inherit
}

body:json {
  {
    "descripcion": "La oficina corporativa de Arcos Plateados está en proceso de mudanza",
    "items": [
      {
        "descripcion": "Sillas de oficina",
        "subcategoria": "sillas",
        "cantidad": 6,
        "pesoKg": 5
      },
      {
        "descripcion": "Mesa rectangular",
        "subcategoria": "mesas",
        "cantidad": 1,
        "pesoKg": 20,
        "valoresAtributos": { "estadoUso": "USADO" }
      }
    ]
  }
}

tests {
  test("responde 201 Created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("segmenta la carga en una donación por ítem (2 subcategorías -> 2 donaciones)", function() {
    const body = res.getBody();
    expect(body).to.be.an("array");
    expect(body.length).to.equal(2);
    expect(body[0].estadoActual).to.equal("EN_DEPOSITO");
    expect(body[1].estadoActual).to.equal("EN_DEPOSITO");
  });
}

example {
  name: 201 Response
  description: Created
  
  request: {
    url: {{baseUrl}}/api/donaciones
    method: POST
    mode: json
    body:json: {
      {
        "descripcion": "",
        "items": [
          {
            "descripcion": "",
            "subcategoria": "",
            "cantidad": 0,
            "foto": "",
            "pesoKg": 0,
            "volumenM3": 0,
            "alturaM": 0,
            "valoresAtributos": {}
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: */*
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "id": 0,
            "descripcionItem": "",
            "cantidadAsignada": 0,
            "estadoActual": "EN_DEPOSITO",
            "entidadBeneficiariaId": 0,
            "necesidadId": 0,
            "pesoKg": 0,
            "volumenM3": 0,
            "alturaM": 0
          }
        ]
      '''
    }
  }
}
