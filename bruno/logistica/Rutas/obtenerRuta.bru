meta {
  name: obtenerRuta
  type: http
  seq: 2
  tags: [
    Rutas
  ]
}

get {
  url: {{baseUrl}}/api/rutas/:id
  body: none
  auth: none
}

params:path {
  id: 1
}

docs {
  Obtiene una ruta por id. 404 si no existe -- validado en vivo (GlobalExceptionHandler agregado en Fase 2, antes devolvía 500).
}

example {
  name: 404 Response
  description: Not Found (id inexistente)

  request: {
    url: {{baseUrl}}/api/rutas/:id
    method: GET
    mode: none
    params:path: {
      id: 999
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''
        {
          "error": "No existe la ruta con id: 999"
        }
      '''
    }
  }
}
