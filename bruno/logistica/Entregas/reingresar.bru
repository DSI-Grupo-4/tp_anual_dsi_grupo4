meta {
  name: reingresar
  type: http
  seq: 2
  tags: [
    Entregas
  ]
}

post {
  url: {{baseUrl}}/api/entregas/:id/reingresar
  body: none
  auth: none
}

params:path {
  id: 1
}

docs {
  La persona administradora revisó una entrega NO_RECIBIDA y decide que la donación vuelve al depósito: pasa a PENDIENTE para que la próxima planificación la vuelva a tomar. 404 si no existe, 409 si la entrega no está en NO_RECIBIDA. Validado en vivo.
}

example {
  name: 409 Response
  description: Conflict (la entrega no está en NO_RECIBIDA)

  request: {
    url: {{baseUrl}}/api/entregas/:id/reingresar
    method: POST
    mode: none
    params:path: {
      id: 1
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: text
      content: '''
        {
          "error": "La entrega 1 no puede reingresar al depósito estando en estado PENDIENTE"
        }
      '''
    }
  }
}
