meta {
  name: obtenerEstado
  type: http
  seq: 1
  tags: [
    Entregas
  ]
}

get {
  url: {{baseUrl}}/api/entregas/:id/estado
  body: none
  auth: none
}

params:path {
  id: 1
}

docs {
  Estado actual de una entrega puntual. 404 si no existe -- validado en vivo.
}

example {
  name: 404 Response
  description: Not Found (id inexistente)

  request: {
    url: {{baseUrl}}/api/entregas/:id/estado
    method: GET
    mode: none
    params:path: {
      id: 999
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 404
      text: Not Found
    }

    body: {
      type: text
      content: '''
        {
          "error": "No existe la entrega con id: 999"
        }
      '''
    }
  }
}
