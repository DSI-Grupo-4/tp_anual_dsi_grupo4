meta {
  name: confirmarRecepcion
  type: http
  seq: 1
  tags: [
    Paradas
  ]
}

post {
  url: {{baseUrl}}/api/rutas/:idRuta/paradas/:idParada/confirmar
  body: json
  auth: none
}

params:path {
  idRuta: 1
  idParada: 1
}

body:json {
  {
    "url": "https://ejemplo.com/foto-entrega-123.jpg",
    "fecha": "2026-10-08"
  }
}

docs {
  Confirma la recepción de las entregas de una parada (sube la foto de entrega) y dispara el evento ENTREGA_CONFIRMADA por cada una. 404 si la ruta o la parada no existen.
}
