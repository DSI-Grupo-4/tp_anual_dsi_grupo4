}

get {
  url: {{baseUrl}}/api/eventos
  body: none
  auth: none
}

docs {
  Eventos logísticos (RUTA_PLANIFICADA, RUTA_INICIADA, ENTREGA_CONFIRMADA, ENTREGA_NO_RECIBIDA) todavía no publicados. Donaciones hace polling de este endpoint (EventosLogisticaScheduler); Logística nunca llama a Donaciones.
}
