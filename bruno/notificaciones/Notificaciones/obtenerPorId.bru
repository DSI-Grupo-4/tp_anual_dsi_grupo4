meta {
  name: obtenerPorId
  type: http
  seq: 2
  tags: [
    Notificaciones
  ]
}

get {
  url: {{baseUrl}}/api/notificaciones/:id
  body: none
  auth: none
}

params:path {
  id: 5c290be7-f21f-4c65-8805-95fb62ed0718
}

docs {
  Obtiene una notificación por su id interno (no por eventoId). 404 si no existe.
}

example {
  name: 200 Response
  description: OK

  request: {
    url: {{baseUrl}}/api/notificaciones/:id
    method: GET
    mode: none
    params:path: {
      id: 5c290be7-f21f-4c65-8805-95fb62ed0718
    }
  }

  response: {
    headers: {
      Content-Type: application/json
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: text
      content: '''
        {
          "id": "5c290be7-f21f-4c65-8805-95fb62ed0718",
          "mensaje": "hola",
          "medio": "EMAIL",
          "contacto": "x@x.com",
          "estado": "COMPLETADA",
          "servicioOrigen": "smoke",
          "fechaCreacion": "2026-10-08T18:54:49.054232795",
          "tipoEvento": "TEST",
          "eventoId": "evt-smoke-1"
        }
      '''
    }
  }
}
