# Copiar a servicio-incentivos/.env (no se versiona). run-servicios lo carga solo.
# true: la API exige el token de Keycloak y la consulta a Donaciones pide el suyo.
SEGURIDAD_HABILITADA=false
# Secret del cliente "servicio-incentivos": el mismo valor que
# KEYCLOAK_INCENTIVOS_CLIENT_SECRET de keycloak/.env, o el de la consola.
KEYCLOAK_CLIENT_SECRET=pegar-el-secret-del-cliente
