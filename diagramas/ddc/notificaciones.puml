@startuml ModeloDominioNotificaciones

title Servicio de Notificaciones - Modelo de dominio

top to bottom direction
skinparam classAttributeIconSize 0

' Fuente: model, enums, strategy, proveedores, NotificacionService y EnvioNotificacionException.
' Todos los atributos declarados se muestran dentro de sus clases.
' Se incluyen métodos públicos, de paquete, privados y constructores.
' Se omiten getters y setters simples; se conservan operaciones con lógica.
' Los tipos de DTOs, repositorios y frameworks aparecen en firmas sin desplegar sus clases.
' Los controladores, el consumidor y las colas quedan fuera de este diagrama de dominio.
' Las flechas no contienen etiquetas ni multiplicidades.

' ===== NOTIFICACION =====

class Notificacion <<Entity>> {

- {static} MAX_DETALLE_ERROR: int = 500
- id: String
- mensaje: String
- medio: MedioComunicacion
- contacto: String
- estado: EstadoNotificacion
- servicioOrigen: String
- tipoEvento: String
- eventoId: String
- fechaCreacion: LocalDateTime
- fechaEnvio: LocalDateTime
- intentos: int
- detalleError: String

--

+ Notificacion()
+ Notificacion(mensaje: String, medio: MedioComunicacion, contacto: String, servicioOrigen: String, tipoEvento: String, eventoId: String)
+ registrarIntento(): void
+ marcarCompletada(): void
+ marcarFallida(error: String): void
+ estaCompletada(): boolean
}

enum MedioComunicacion {

WHATSAPP
EMAIL
SMS
}

enum EstadoNotificacion {

PENDIENTE
COMPLETADA
FALLIDA
}

' ===== ESTRATEGIA DE ENVIO =====

interface Notificador {

+ enviarNotificacion(notificacion: Notificacion): void
}

class EmailNotificador {

- {static} logger: Logger
- mailSender: JavaMailSender
- remitente: String

--

+ EmailNotificador(mailSender: JavaMailSender, remitente: String)
+ enviarNotificacion(notificacion: Notificacion): void
- asunto(tipoEvento: String): String
}

class SmsNotificador {

- {static} logger: Logger
- twilio: TwilioCliente

--

+ SmsNotificador(twilio: TwilioCliente)
+ enviarNotificacion(notificacion: Notificacion): void
}

class WhatsAppNotificador {

- {static} logger: Logger
- twilio: TwilioCliente

--

+ WhatsAppNotificador(twilio: TwilioCliente)
+ enviarNotificacion(notificacion: Notificacion): void
}

class NotificadorFactory {

- notificadoresPorMedio: Map<MedioComunicacion, Notificador>

--

+ NotificadorFactory(emailNotificador: EmailNotificador, smsNotificador: SmsNotificador, whatsAppNotificador: WhatsAppNotificador)
+ obtenerNotificador(medio: MedioComunicacion): Notificador
}

' ===== PROVEEDOR DE SMS Y WHATSAPP =====

class TwilioCliente {

- {static} logger: Logger
- {static} MAX_VARIABLE: int = 200
- habilitado: boolean
- numeroSms: String
- numeroWhatsApp: String
- contentSidWhatsApp: String
- cuerpoSmsPrueba: String
- whatsAppActivo: boolean

--

+ TwilioCliente(accountSid: String, authToken: String, numeroSms: String, numeroWhatsApp: String, contentSidWhatsApp: String, cuerpoSmsPrueba: String, whatsAppActivo: boolean)
+ TwilioCliente(accountSid: String, authToken: String, numeroSms: String, numeroWhatsApp: String)
+ estaHabilitado(): boolean
+ puedeEnviarSms(): boolean
+ puedeEnviarWhatsApp(): boolean
+ enviarSms(destino: String, texto: String): String
+ enviarWhatsApp(destino: String, texto: String): String
~ cuerpoSms(texto: String): String
~ {static} variablesPlantilla(texto: String): String
+ {static} aE164(numero: String): String
- descripcionSms(): String
- descripcionWhatsApp(): String
}

' ===== GESTION DE NOTIFICACIONES =====

class NotificacionService {

- {static} logger: Logger
- notificadorFactory: NotificadorFactory
- repository: NotificacionRepository

--

+ NotificacionService(notificadorFactory: NotificadorFactory, repository: NotificacionRepository)
+ enviarNotificacion(request: NotificacionRequestDTO): Notificacion
+ despachar(notificacion: Notificacion): Notificacion
+ buscarPorId(id: String): Optional<Notificacion>
+ listarTodas(): List<Notificacion>
- normalizarOrigen(origen: String): String
}

class EnvioNotificacionException <<exception>> {

+ EnvioNotificacionException(mensaje: String)
+ EnvioNotificacionException(mensaje: String, causa: Throwable)
}

' ===== HERENCIA E IMPLEMENTACION =====

Notificador <|.. EmailNotificador
Notificador <|.. SmsNotificador
Notificador <|.. WhatsAppNotificador

' ===== RELACIONES ESTRUCTURALES =====

Notificacion --> MedioComunicacion
Notificacion --> EstadoNotificacion
NotificacionService --> NotificadorFactory
NotificadorFactory --> MedioComunicacion
NotificadorFactory --> Notificador
SmsNotificador --> TwilioCliente
WhatsAppNotificador --> TwilioCliente

' ===== DEPENDENCIAS =====

EmailNotificador ..> Notificacion
NotificacionService ..> EnvioNotificacionException
NotificacionService ..> Notificacion
NotificacionService ..> Notificador
Notificador ..> Notificacion
NotificadorFactory ..> EmailNotificador
NotificadorFactory ..> SmsNotificador
NotificadorFactory ..> WhatsAppNotificador
SmsNotificador ..> Notificacion
WhatsAppNotificador ..> Notificacion

@enduml
