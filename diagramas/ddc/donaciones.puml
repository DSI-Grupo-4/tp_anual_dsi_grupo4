}

class PrioridadSubatendidos {

+ ejecutarAlgoritmo(donacion: Donacion, entidades: List<EntidadBeneficiaria>): List<EntidadBeneficiaria>
- tieneNecesidadCompatible(entidad: EntidadBeneficiaria, donacion: Donacion): boolean
- donacionesEntregadasEnTrimestre(entidad: EntidadBeneficiaria, desde: LocalDateTime): long
}

