@startuml ModeloDominioIncentivos

title Servicio de Incentivos - Modelo de dominio

top to bottom direction
skinparam classAttributeIconSize 0

' Fuente: paquetes consultor, donante, donacion, misiones, progreso, ranking y metricas.
' Todos los atributos declarados se muestran dentro de sus clases, incluidas referencias y colecciones.
' Los miembros heredados se muestran en la superclase; no se duplican.
' Se incluyen métodos públicos, protegidos, de paquete, privados y constructores.
' Se omiten getters/setters simples; se conservan consultas con lógica y accesos a singletons.
' Los constructores generados por Lombok también se muestran.
' Los tipos externos aparecen en firmas sin desplegar DTOs ni infraestructura.
' Las clases internas usan el nombre Exterior.Interior.
' Las flechas no contienen etiquetas ni multiplicidades.

' ===== FACHADA =====

class Consultor <<Singleton >> {

- {static} log: Logger
- {static} instancia: Consultor
- misiones: GestorMisiones
- donantes: GestorDonante
- rankings: HistorialRanking
- beneficiarios: Set<Beneficiario>
- beneficiarioRepository: BeneficiarioRepository
- restTemplate: RestTemplate
- webhookN8nUrl: String
- notificacionesClient: NotificacionesClient

--

- Consultor()
+ {static} getInstance(): Consultor
+ configurarWebhookN8n(webhookN8nUrl: String): void
+ configurarNotificacionesClient(notificacionesClient: NotificacionesClient): void
+ configurarPersistencia(beneficiarioRepository: BeneficiarioRepository): void
+ obtenerMetricasActividad(donante: Donante, periodo: Periodo): MetricasActividad
- categoriaActualDe(donante: Donante): String
- calcularEvolucionMensual(donaciones: List<DatosDonacion>): List<EvolucionMensual>
+ obtenerMetricasSistema(): MetricasSistema
+ obtenerMisionesDisponibles(donante: Donante): List<Mision>
+ obtenerInsignias(donante: Donante): List<Insignia>
+ marcarInsigniaVisible(donante: Donante, insigniaNombre: String): void
+ ocultarInsignia(donante: Donante, insigniaNombre: String): void
- buscarProgresoInsignia(donante: Donante, insigniaNombre: String): ProgresoInsignia
+ obtenerOCrearBeneficiario(id: Long, nombre: String): Beneficiario
+ registrarActividadDonacion(donante: Donante, datosDonacion: DatosDonacion): ProgresoInsignia
+ ejecutarVerificacionVigenciaMisiones(): void
+ ejecutarCierreMensualRanking(): void
+ obtenerHistorialRanking(): List<Ranking>
+ obtenerRankingDeMes(fecha: LocalDate): Ranking
+ obtenerUltimoRanking(): Ranking
+ publicarInsignia(donante: Donante, insignia: Insignia): void
+ notificarMisionCompletada(donante: Donante, obtenida: ProgresoInsignia): void
+ notificarCambioCategoria(donante: Donante, categoriaNombre: String): void
- enviarNotificacion(tipo: String, donante: Donante, mensaje: String): void
}

' ===== DONANTE =====

class Donante {

- id: Long
- nombre: String
- medioContactoPreferido: String
- contactoPreferido: String
- solicitudesDonacionHechas: int
- beneficiariosAyudados: Set<Beneficiario>
- progresoAsociado: ProgresoAsociado
- historialDonaciones: List<DatosDonacion>

--

# Donante()
+ Donante(id: Long)
+ actualizarNombreSiFalta(nombre: String): void
+ actualizarContactoSiFalta(medio: String, contacto: String): void
+ registrarActividadDonacion(datosDonacion: DatosDonacion): ProgresoInsignia
+ verificarVigenciaMisiones(): void
}

class GestorDonante <<Singleton>> {

- {static} instancia: GestorDonante
- donantes: List<Donante>
- donanteRepository: DonanteRepository

--

- GestorDonante()
+ {static} getInstance(): GestorDonante
+ configurarPersistencia(donanteRepository: DonanteRepository): void
+ verificarVigenciaMisiones(): void
+ obtenerDonante(id: Long): Donante
+ obtenerDonante(id: Long, nombre: String): Donante
+ buscarDonante(id: Long): Donante
+ listarDonantes(): List<Donante>
+ guardar(donante: Donante): void
}

class Beneficiario {

- id: Long
- nombre: String

--

# Beneficiario()
+ Beneficiario(id: Long, nombre: String)
+ equals(o: Object): boolean
+ hashCode(): int
}

class DatosDonacion {

- idDatosDonacion: Integer
- donacionId: Long
- fecha: LocalDate
- categoriaBien: String
- cantidadBienes: BigDecimal
- donacionExitosa: boolean
- beneficiario: Beneficiario
- donante: Donante

--

# DatosDonacion()
+ DatosDonacion(fecha: LocalDate, categoriaBien: String, cantidadBienes: BigDecimal, donacionExitosa: boolean, beneficiario: Beneficiario)
}

' ===== CATALOGO DE MISIONES =====

class GestorMisiones <<Singleton>> {

- {static} instancia: GestorMisiones
- catalogoCategorias: List<Categoria>
- categoriaRepository: CategoriaRepository

--

- GestorMisiones()
+ {static} getInstance(): GestorMisiones
- sembrarCatalogo(): void
+ agregarCategoria(categoria: Categoria): void
+ siguienteCategoria(indice: int): Categoria
+ cantCategorias(): int
+ buscarCategoriaPorNombre(nombre: String): Optional<Categoria>
+ configurarPersistencia(categoriaRepository: CategoriaRepository): void
}

class Categoria {

- idCategoria: Integer
- nombre: String
- orden: Integer
- misiones: List<Mision>

--

# Categoria()
+ Categoria(nombre: String)
+ agregarMision(mision: Mision): void
+ indexMision(indice: int): Mision
+ cantMisiones(): int
}

abstract class Mision {

- idMision: Integer
- categoriaAsociada: Categoria
- orden: Integer
- nombreMision: String
- insigniaAsociada: Insignia

--

# Mision()
# Mision(nombreMision: String, insigniaAsociada: Insignia)
~ asignarCategoria(categoria: Categoria, orden: int): void
+ {abstract} validarCumplimiento(progresoMision: ProgresoMision): boolean
+ {abstract} crearProgreso(): ProgresoMision
}

class "Mision.Racha" as Mision_Racha {

- mesesRequeridos: int

--

# Racha()
+ Racha(nombreMision: String, insigniaAsociada: Insignia, mesesRequeridos: int)
+ validarCumplimiento(progresoMision: ProgresoMision): boolean
+ crearProgreso(): ProgresoMision
}

class "Mision.Completitud" as Mision_Completitud {

- categoriasRequeridas: int

--

# Completitud()
+ Completitud(nombreMision: String, insigniaAsociada: Insignia, categoriasRequeridas: int)
+ validarCumplimiento(progresoMision: ProgresoMision): boolean
+ crearProgreso(): ProgresoMision
}

class "Mision.HabilDonador" as Mision_HabilDonador {

- cantidadBienesRequerida: int

--

# HabilDonador()
+ HabilDonador(nombreMision: String, insigniaAsociada: Insignia, cantidadBienesRequerida: int)
+ validarCumplimiento(progresoMision: ProgresoMision): boolean
+ crearProgreso(): ProgresoMision
}

class "Mision.DonacionesExitosas" as Mision_DonacionesExitosas {

- donacionesRequeridas: int

--

# DonacionesExitosas()
+ DonacionesExitosas(nombreMision: String, insigniaAsociada: Insignia, donacionesRequeridas: int)
+ validarCumplimiento(progresoMision: ProgresoMision): boolean
+ crearProgreso(): ProgresoMision
}

class Insignia {

- idInsignia: Integer
- nombre: String
- imagenUrl: String

--

# Insignia()
+ Insignia(nombre: String, imagenUrl: String)
}

' ===== PROGRESO =====

class ProgresoAsociado {

- idProgresoAsociado: Integer
- categoriasObtenidas: List<ProgresoCategoria>
- gestorAsociado: GestorMisiones
- misionActual: ProgresoMision
- indiceMisionActual: int

--

# ProgresoAsociado()
+ ProgresoAsociado(gestorAsociado: GestorMisiones)
- iniciarCategoria(categoria: Categoria): void
+ subirCategoria(): void
+ siguienteMision(): Mision
+ actualizarProgreso(datosDonacion: DatosDonacion): ProgresoInsignia
+ verificarVigenciaMisiones(): void
}

class ProgresoCategoria {

- idProgresoCategoria: Integer
- progresoAsociado: ProgresoAsociado
- nombre: String
- orden: Integer
- misiones: List<ProgresoMision>

--

# ProgresoCategoria()
+ ProgresoCategoria(progresoAsociado: ProgresoAsociado, categoria: Categoria, orden: int)
+ cantMisionesCompletadas(): int
}

abstract class ProgresoMision {

- idProgresoMision: Integer
- progresoCategoriaAsociado: ProgresoCategoria
- orden: Integer
- misionAsociada: Mision
- insigniaObtenida: ProgresoInsignia

--

# ProgresoMision()
# ProgresoMision(misionAsociada: Mision)
~ asignarProgresoCategoria(progresoCategoria: ProgresoCategoria, orden: int): void
+ completarMision(): ProgresoInsignia
+ asignarInsignia(): void
+ {abstract} actualizarProgresoMision(datosDonacion: DatosDonacion): void
+ evaluarVigencia(fechaReferencia: LocalDate): void
+ {abstract} obtenerProgresoActual(): BigDecimal
+ {abstract} distanciaRestante(): BigDecimal
}

class "ProgresoMision.ProgresoRacha" as ProgresoMision_ProgresoRacha {

- mesesConsecutivosActuales: int
- ultimaDonacionRegistrada: LocalDate

--

# ProgresoRacha()
+ ProgresoRacha(misionAsociada: Mision)
+ actualizarProgresoMision(datosDonacion: DatosDonacion): void
+ evaluarVigencia(fechaReferencia: LocalDate): void
+ obtenerProgresoActual(): BigDecimal
+ distanciaRestante(): BigDecimal
}

class "ProgresoMision.ProgresoCompletitud" as ProgresoMision_ProgresoCompletitud {

- categoriasCubiertas: Set<String>

--

# ProgresoCompletitud()
+ ProgresoCompletitud(misionAsociada: Mision)
+ actualizarProgresoMision(datosDonacion: DatosDonacion): void
+ obtenerProgresoActual(): BigDecimal
+ distanciaRestante(): BigDecimal
}

class "ProgresoMision.ProgresoHabilDonador" as ProgresoMision_ProgresoHabilDonador {

- mejorDonacionRegistrada: BigDecimal

--

# ProgresoHabilDonador()
+ ProgresoHabilDonador(misionAsociada: Mision)
+ actualizarProgresoMision(datosDonacion: DatosDonacion): void
+ obtenerProgresoActual(): BigDecimal
+ distanciaRestante(): BigDecimal
}

class "ProgresoMision.ProgresoDonacionesExitosas" as ProgresoMision_ProgresoDonacionesExitosas {

- donacionesExitosasActuales: int

--

# ProgresoDonacionesExitosas()
+ ProgresoDonacionesExitosas(misionAsociada: Mision)
+ actualizarProgresoMision(datosDonacion: DatosDonacion): void
+ obtenerProgresoActual(): BigDecimal
+ distanciaRestante(): BigDecimal
}

class ProgresoInsignia {

- idProgresoInsignia: Integer
- insigniaAsociada: Insignia
- fechaObtencion: LocalDate
- visible: boolean

--

# ProgresoInsignia()
+ ProgresoInsignia(insigniaAsociada: Insignia)
+ marcarVisible(): void
+ ocultarInsignia(): void
}

' ===== RANKING =====

class HistorialRanking <<Singleton>> {

- {static} TOP_DONANTES: int
- {static} instancia: HistorialRanking
- donantesMisionesMensuales: List<ActividadMensualDonante>
- rankings: List<Ranking>
- rankingRepository: RankingRepository
- actividadMensualDonanteRepository: ActividadMensualDonanteRepository

--

- HistorialRanking()
+ {static} getInstance(): HistorialRanking
+ configurarPersistencia(rankingRepository: RankingRepository, actividadMensualDonanteRepository: ActividadMensualDonanteRepository): void
+ generarRanking(): void
+ registrarMisionCompletada(donante: Donante): void
+ obtenerPosicionActual(donante: Donante): Optional<Integer>
+ obtenerHistorial(): List<Ranking>
+ obtenerUltimoRanking(): Ranking
+ obtenerRankingDeMes(fecha: LocalDate): Ranking
}

class Ranking {

- idRanking: Integer
- fechaEmision: LocalDate
- topDonantes: List<ActividadMensualDonante>

--

# Ranking()
+ Ranking(fechaEmision: LocalDate, topDonantes: List<ActividadMensualDonante>)
}

class ActividadMensualDonante {

- idActividadMensualDonante: Integer
- donanteAsociado: Donante
- cantidad: int
- ranking: Ranking
- posicion: Integer

--

# ActividadMensualDonante()
+ ActividadMensualDonante(donanteAsociado: Donante)
+ incrementar(): void
}

' ===== METRICAS =====

enum Periodo {

MENSUAL
TRIMESTRAL
SEMESTRAL
ANUAL
HISTORICO
- meses: int

--

- Periodo(meses: int)
+ fechaDesde(referencia: LocalDate): LocalDate
}

class MetricasActividad {

- donanteNombre: String
- categoriaActual: String
- periodo: Periodo
- solicitudesDonacionHechas: int
- beneficiariosAyudados: int
- misionesCompletadas: int
- insigniasObtenidas: int
- impactoAcumulado: BigDecimal
- posicionRanking: Integer
- evolucionMensual: List<EvolucionMensual>

--

+ MetricasActividad(donanteNombre: String, categoriaActual: String, periodo: Periodo, solicitudesDonacionHechas: int, beneficiariosAyudados: int, misionesCompletadas: int, insigniasObtenidas: int, impactoAcumulado: BigDecimal, posicionRanking: Integer, evolucionMensual: List<EvolucionMensual>)
}

class MetricasSistema {

- donantesActivos: int
- solicitudesDonacionTotales: int
- misionesCompletadasTotales: int
- insigniasOtorgadasTotales: int
- evolucionMensual: List<EvolucionMensual>

--

+ MetricasSistema(donantesActivos: int, solicitudesDonacionTotales: int, misionesCompletadasTotales: int, insigniasOtorgadasTotales: int, evolucionMensual: List<EvolucionMensual>)
}

class EvolucionMensual {

- mes: YearMonth
- solicitudes: int
- impacto: BigDecimal

--

+ EvolucionMensual(mes: YearMonth, solicitudes: int, impacto: BigDecimal)
}

' ===== HERENCIA =====

Mision <|-- Mision_Racha
Mision <|-- Mision_Completitud
Mision <|-- Mision_HabilDonador
Mision <|-- Mision_DonacionesExitosas
ProgresoMision <|-- ProgresoMision_ProgresoRacha
ProgresoMision <|-- ProgresoMision_ProgresoCompletitud
ProgresoMision <|-- ProgresoMision_ProgresoHabilDonador
ProgresoMision <|-- ProgresoMision_ProgresoDonacionesExitosas

' ===== RELACIONES ESTRUCTURALES =====

Consultor --> GestorMisiones
Consultor --> GestorDonante
Consultor --> HistorialRanking
Consultor --> Beneficiario
DatosDonacion --> Beneficiario
Donante *-- DatosDonacion
Donante --> Beneficiario
Donante *-- ProgresoAsociado
GestorDonante --> Donante
MetricasActividad --> Periodo
MetricasActividad --> EvolucionMensual
MetricasSistema --> EvolucionMensual
Categoria *-- Mision
GestorMisiones --> Categoria
Mision *-- Insignia
ProgresoAsociado *-- ProgresoCategoria
ProgresoAsociado --> GestorMisiones
ProgresoAsociado --> ProgresoMision
ProgresoCategoria *-- ProgresoMision
ProgresoInsignia --> Insignia
ProgresoMision --> Mision
ProgresoMision *-- ProgresoInsignia
ActividadMensualDonante --> Donante
ActividadMensualDonante --> Ranking
HistorialRanking --> ActividadMensualDonante
HistorialRanking --> Ranking

' ===== DEPENDENCIAS =====

Consultor ..> DatosDonacion
Consultor ..> Donante
Consultor ..> EvolucionMensual
Consultor ..> Insignia
Consultor ..> MetricasActividad
Consultor ..> MetricasSistema
Consultor ..> Mision
Consultor ..> Periodo
Consultor ..> ProgresoInsignia
Consultor ..> Ranking
Donante ..> ProgresoInsignia
HistorialRanking ..> Donante
Mision_Completitud ..> ProgresoMision
Mision_Completitud ..> ProgresoMision_ProgresoCompletitud
Mision_DonacionesExitosas ..> ProgresoMision
Mision_DonacionesExitosas ..> ProgresoMision_ProgresoDonacionesExitosas
Mision_HabilDonador ..> ProgresoMision
Mision_HabilDonador ..> ProgresoMision_ProgresoHabilDonador
Mision_Racha ..> ProgresoMision
Mision_Racha ..> ProgresoMision_ProgresoRacha
ProgresoAsociado ..> Categoria
ProgresoAsociado ..> DatosDonacion
ProgresoAsociado ..> Mision
ProgresoAsociado ..> ProgresoInsignia
ProgresoMision ..> DatosDonacion
ProgresoMision_ProgresoCompletitud ..> DatosDonacion
ProgresoMision_ProgresoDonacionesExitosas ..> DatosDonacion
ProgresoMision_ProgresoHabilDonador ..> DatosDonacion
ProgresoMision_ProgresoRacha ..> DatosDonacion

@enduml
